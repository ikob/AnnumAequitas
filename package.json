{
  "name": "annum-aequitas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Katsushi Kobayashi <ikob@acm.org>",
  "scripts": {
    "prestart": "npm run build",
    "start": "vite preview --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "catalog": "node scripts/collect-instruments.mjs",
    "fixtures": "node scripts/generate-fixtures.ts",
    "prices": "node scripts/collect-prices.ts",
    "fx": "node scripts/collect-fx.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 --test tests/*.test.ts"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "monocart-coverage-reports": "^2.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
